# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json
.ssh_keys/id_rsa
.ssh_keys/id_rsa.pub
models/sam3/checkpoints/sam3.1_multiplex_fp16.safetensors
models/sam3_dl/checkpoints/sam3.1_multiplex_fp16.safetensors
/logs
/data
/tools
/downloads
/input
/references
.vscode/settings.json
/.vscode
.DS_Store
progressive_download.txt
